# Copy this file to .env for local use. Never commit .env or real credentials.
# A non-empty key is required for protected API routes.
RISKGUARD_API_KEY=

# Optional AI investigator provider. Leave blank to use deterministic fallback.
AI_PROVIDER_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# Safe operational defaults.
RISKGUARD_LOG_LEVEL=INFO
RISKGUARD_RATE_LIMIT_REQUESTS=60
RISKGUARD_RATE_LIMIT_WINDOW_SECONDS=60
